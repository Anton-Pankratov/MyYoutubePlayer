CREATE TABLE playbackHistory (
    providerId TEXT NOT NULL,
    externalId TEXT NOT NULL,
    title TEXT NOT NULL,
    thumbnailUrl TEXT,
    positionMs INTEGER NOT NULL DEFAULT 0,
    durationMs INTEGER,
    updatedAtEpochMs INTEGER NOT NULL,
    PRIMARY KEY(providerId, externalId)
);

CREATE TABLE directMediaSource (
    externalId TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    uri TEXT NOT NULL,
    mimeType TEXT,
    thumbnailUrl TEXT,
    authorTitle TEXT,
    durationMs INTEGER
);

CREATE TABLE savedMedia (
    providerId TEXT NOT NULL,
    externalId TEXT NOT NULL,
    title TEXT NOT NULL,
    thumbnailUrl TEXT,
    authorTitle TEXT,
    durationMs INTEGER,
    isFavorite INTEGER NOT NULL DEFAULT 0,
    isWatchLater INTEGER NOT NULL DEFAULT 0,
    favoriteAddedAtEpochMs INTEGER,
    watchLaterAddedAtEpochMs INTEGER,
    PRIMARY KEY(providerId, externalId)
);

CREATE TABLE mediaCollection (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    createdAtEpochMs INTEGER NOT NULL,
    updatedAtEpochMs INTEGER NOT NULL
);

CREATE TABLE collectionMedia (
    collectionId TEXT NOT NULL,
    providerId TEXT NOT NULL,
    externalId TEXT NOT NULL,
    title TEXT NOT NULL,
    thumbnailUrl TEXT,
    authorTitle TEXT,
    durationMs INTEGER,
    addedAtEpochMs INTEGER NOT NULL,
    PRIMARY KEY(collectionId, providerId, externalId),
    FOREIGN KEY(collectionId) REFERENCES mediaCollection(id) ON DELETE CASCADE
);

CREATE INDEX collectionMedia_by_collection_added
ON collectionMedia(collectionId, addedAtEpochMs DESC, providerId, externalId);

CREATE INDEX mediaCollection_by_updated
ON mediaCollection(updatedAtEpochMs DESC, name, id);

upsertDirectMedia:
INSERT OR REPLACE INTO directMediaSource(externalId, title, uri, mimeType, thumbnailUrl, authorTitle, durationMs)
VALUES (?, ?, ?, ?, ?, ?, ?);

findDirectMedia:
SELECT * FROM directMediaSource WHERE externalId = ?;

deleteDirectMedia:
DELETE FROM directMediaSource WHERE externalId = ?;

selectRecent:
SELECT * FROM playbackHistory
ORDER BY updatedAtEpochMs DESC
LIMIT ?;

upsertHistory:
INSERT OR REPLACE INTO playbackHistory(providerId, externalId, title, thumbnailUrl, positionMs, durationMs, updatedAtEpochMs)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteHistory:
DELETE FROM playbackHistory WHERE providerId = ? AND externalId = ?;

selectSavedMedia:
SELECT * FROM savedMedia WHERE providerId = ? AND externalId = ?;

selectFavorites:
SELECT * FROM savedMedia
WHERE isFavorite = 1
ORDER BY favoriteAddedAtEpochMs DESC, providerId ASC, externalId ASC;

selectWatchLater:
SELECT * FROM savedMedia
WHERE isWatchLater = 1
ORDER BY watchLaterAddedAtEpochMs DESC, providerId ASC, externalId ASC;

upsertSavedMedia:
INSERT OR REPLACE INTO savedMedia(
    providerId, externalId, title, thumbnailUrl, authorTitle, durationMs,
    isFavorite, isWatchLater, favoriteAddedAtEpochMs, watchLaterAddedAtEpochMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSavedMedia:
DELETE FROM savedMedia WHERE providerId = ? AND externalId = ?;

selectCollections:
SELECT mediaCollection.*, COUNT(collectionMedia.externalId) AS itemCount
FROM mediaCollection
LEFT JOIN collectionMedia ON collectionMedia.collectionId = mediaCollection.id
GROUP BY mediaCollection.id
ORDER BY mediaCollection.updatedAtEpochMs DESC, lower(mediaCollection.name) ASC, mediaCollection.id ASC;

selectCollection:
SELECT * FROM mediaCollection WHERE id = ?;

selectCollectionItems:
SELECT * FROM collectionMedia
WHERE collectionId = ?
ORDER BY addedAtEpochMs DESC, providerId ASC, externalId ASC;

selectCollectionIdsContaining:
SELECT collectionId FROM collectionMedia
WHERE providerId = ? AND externalId = ?;

insertCollection:
INSERT INTO mediaCollection(id, name, createdAtEpochMs, updatedAtEpochMs)
VALUES (?, ?, ?, ?);

updateCollectionName:
UPDATE mediaCollection SET name = ?, updatedAtEpochMs = ? WHERE id = ?;

updateCollectionTimestamp:
UPDATE mediaCollection SET updatedAtEpochMs = ? WHERE id = ?;

deleteCollectionMemberships:
DELETE FROM collectionMedia WHERE collectionId = ?;

deleteCollection:
DELETE FROM mediaCollection WHERE id = ?;

insertCollectionMedia:
INSERT OR IGNORE INTO collectionMedia(
    collectionId, providerId, externalId, title, thumbnailUrl, authorTitle, durationMs, addedAtEpochMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteCollectionMedia:
DELETE FROM collectionMedia
WHERE collectionId = ? AND providerId = ? AND externalId = ?;
