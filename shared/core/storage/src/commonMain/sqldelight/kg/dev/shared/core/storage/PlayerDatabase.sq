CREATE TABLE playbackHistory (
    providerId TEXT NOT NULL,
    externalId TEXT NOT NULL,
    title TEXT NOT NULL,
    thumbnailUrl TEXT,
    positionMs INTEGER NOT NULL DEFAULT 0,
    durationMs INTEGER,
    updatedAtEpochMs INTEGER NOT NULL,
    PRIMARY KEY(providerId, externalId)
);

CREATE TABLE directMediaSource (
    externalId TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    uri TEXT NOT NULL,
    mimeType TEXT,
    thumbnailUrl TEXT,
    authorTitle TEXT,
    durationMs INTEGER
);

CREATE TABLE savedMedia (
    providerId TEXT NOT NULL,
    externalId TEXT NOT NULL,
    title TEXT NOT NULL,
    thumbnailUrl TEXT,
    authorTitle TEXT,
    durationMs INTEGER,
    isFavorite INTEGER NOT NULL DEFAULT 0,
    isWatchLater INTEGER NOT NULL DEFAULT 0,
    favoriteAddedAtEpochMs INTEGER,
    watchLaterAddedAtEpochMs INTEGER,
    PRIMARY KEY(providerId, externalId)
);

upsertDirectMedia:
INSERT OR REPLACE INTO directMediaSource(externalId, title, uri, mimeType, thumbnailUrl, authorTitle, durationMs)
VALUES (?, ?, ?, ?, ?, ?, ?);

findDirectMedia:
SELECT * FROM directMediaSource WHERE externalId = ?;

deleteDirectMedia:
DELETE FROM directMediaSource WHERE externalId = ?;

selectRecent:
SELECT * FROM playbackHistory
ORDER BY updatedAtEpochMs DESC
LIMIT ?;

upsertHistory:
INSERT OR REPLACE INTO playbackHistory(providerId, externalId, title, thumbnailUrl, positionMs, durationMs, updatedAtEpochMs)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteHistory:
DELETE FROM playbackHistory WHERE providerId = ? AND externalId = ?;

selectSavedMedia:
SELECT * FROM savedMedia WHERE providerId = ? AND externalId = ?;

selectFavorites:
SELECT * FROM savedMedia
WHERE isFavorite = 1
ORDER BY favoriteAddedAtEpochMs DESC, providerId ASC, externalId ASC;

selectWatchLater:
SELECT * FROM savedMedia
WHERE isWatchLater = 1
ORDER BY watchLaterAddedAtEpochMs DESC, providerId ASC, externalId ASC;

upsertSavedMedia:
INSERT OR REPLACE INTO savedMedia(
    providerId, externalId, title, thumbnailUrl, authorTitle, durationMs,
    isFavorite, isWatchLater, favoriteAddedAtEpochMs, watchLaterAddedAtEpochMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSavedMedia:
DELETE FROM savedMedia WHERE providerId = ? AND externalId = ?;
