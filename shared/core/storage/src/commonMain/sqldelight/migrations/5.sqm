ALTER TABLE collectionMedia ADD COLUMN manualPosition INTEGER NOT NULL DEFAULT 0;

UPDATE collectionMedia
SET manualPosition = (
    SELECT COUNT(*)
    FROM collectionMedia prior
    WHERE prior.collectionId = collectionMedia.collectionId
      AND (
          prior.addedAtEpochMs > collectionMedia.addedAtEpochMs
          OR (prior.addedAtEpochMs = collectionMedia.addedAtEpochMs AND prior.providerId < collectionMedia.providerId)
          OR (prior.addedAtEpochMs = collectionMedia.addedAtEpochMs AND prior.providerId = collectionMedia.providerId AND prior.externalId < collectionMedia.externalId)
      )
);

DROP INDEX collectionMedia_by_collection_added;

CREATE INDEX collectionMedia_by_collection_position
ON collectionMedia(collectionId, manualPosition, providerId, externalId);
